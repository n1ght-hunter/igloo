interface app-instance {
    use callbacks.{callback-id};
    use message-types.{message-value};
    use task.{task};
    use widgets.{view-tree};

    /// A running plugin instance. Owns the plugin's state and every callback it has handed
    /// to the host for the current frame.
    resource application {
        constructor();
        /// The task to run right after construction — the analogue of iced's
        /// `new() -> (State, Task)`.
        boot: func() -> task;
        view: func() -> view-tree;
        update: func(id: callback-id, value: message-value) -> task;
    }
}
